@model AE_RA8_RBM.DTOs.IndicadorDto

@{
    ViewData["Title"] = "Eliminar Indicador";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle"></i>
        <strong>¡Atención!</strong> Está a punto de eliminar este indicador mediante la API REST (operación DELETE). Esta acción no se puede deshacer.
    </div>

    <div class="card">
        <div class="card-header bg-danger text-white">
            <h5 class="mb-0"><i class="bi bi-trash"></i> Confirmar Eliminación</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">@Model.Tipo</span>
                </dd>

                <dt class="col-sm-3">Categoría</dt>
                <dd class="col-sm-9">@Model.Categoria</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9">@Model.Nombre</dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">@(Model.Descripcion ?? "N/A")</dd>

                <dt class="col-sm-3">Valor</dt>
                <dd class="col-sm-9"><strong>@Model.Valor @Model.Unidad</strong></dd>

                <dt class="col-sm-3">Fecha</dt>
                <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-3">Ámbito</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">@Model.Ambito</span>
                </dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Confirmar Eliminación
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>
