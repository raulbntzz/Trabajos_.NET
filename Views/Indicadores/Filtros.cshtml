@model IEnumerable<AE_RA8_RBM.DTOs.IndicadorDto>

@{
    ViewData["Title"] = "Filtrar Indicadores";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="mb-3">
        <p class="text-muted">
            Aplica filtros para consultar indicadores específicos según tipo o ámbito.
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Aplicar Filtros</h5>
        </div>
        <div class="card-body">
            <form asp-action="Filtros" method="get">
                <div class="row">
                    <div class="col-md-5">
                        <div class="mb-3">
                            <label class="form-label">Filtrar por Tipo</label>
                            <select name="tipo" class="form-select">
                                <option value="">-- Seleccione un tipo --</option>
                                @if (ViewBag.Tipos != null)
                                {
                                    foreach (var tipo in ViewBag.Tipos)
                                    {
                                        if (tipo == ViewBag.TipoSeleccionado)
                                        {
                                            <option value="@tipo" selected>@tipo</option>
                                        }
                                        else
                                        {
                                            <option value="@tipo">@tipo</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="mb-3">
                            <label class="form-label">Filtrar por Ámbito</label>
                            <select name="ambito" class="form-select">
                                <option value="">-- Seleccione un ámbito --</option>
                                @if (ViewBag.Ambitos != null)
                                {
                                    foreach (var ambito in ViewBag.Ambitos)
                                    {
                                        if (ambito == ViewBag.AmbitoSeleccionado)
                                        {
                                            <option value="@ambito" selected>@ambito</option>
                                        }
                                        else
                                        {
                                            <option value="@ambito">@ambito</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Filtrar
                        </button>
                    </div>
                </div>
            </form>
            <div class="mt-2">
                <a asp-action="Index" class="btn btn-secondary btn-sm">
                    <i class="bi bi-x-circle"></i> Limpiar filtros
                </a>
            </div>
        </div>
    </div>

    @if (ViewBag.FiltroAplicado != null)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> <strong>Filtro aplicado:</strong> @ViewBag.FiltroAplicado
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Resultados (Total: @Model.Count())</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>Categoría</th>
                            <th>Nombre</th>
                            <th>Valor</th>
                            <th>Unidad</th>
                            <th>Fecha</th>
                            <th>Ámbito</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><span class="badge bg-primary">@item.Tipo</span></td>
                                <td>@item.Categoria</td>
                                <td>@item.Nombre</td>
                                <td><strong>@item.Valor</strong></td>
                                <td>@item.Unidad</td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td><span class="badge bg-secondary">@item.Ambito</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle"></i> No se encontraron indicadores con los filtros aplicados.
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
    </div>
</div>
