@model IEnumerable<AE_RA8_RBM.DTOs.IndicadorDto>

@{
    ViewData["Title"] = "Indicadores de Digitalización y Sostenibilidad";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Nuevo Indicador
        </a>
        <a asp-action="Filtros" class="btn btn-secondary">
            <i class="bi bi-funnel"></i> Aplicar Filtros
        </a>
        <a asp-action="Resumen" class="btn btn-info">
            <i class="bi bi-bar-chart"></i> Ver Resumen
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Listado Completo de Indicadores (Total: @Model.Count())</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>Categoría</th>
                            <th>Nombre</th>
                            <th>Valor</th>
                            <th>Unidad</th>
                            <th>Fecha</th>
                            <th>Ámbito</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    <span class="badge bg-primary">@item.Tipo</span>
                                </td>
                                <td>@item.Categoria</td>
                                <td>@item.Nombre</td>
                                <td><strong>@item.Valor</strong></td>
                                <td>@item.Unidad</td>
                                <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-secondary">@item.Ambito</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Ver detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-circle"></i> No hay indicadores disponibles. 
                    <a asp-action="Create">Crear el primero</a>
                </div>
            }
        </div>
    </div>
</div>
