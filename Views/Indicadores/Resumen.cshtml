@model AE_RA8_RBM.Models.ResumenIndicadores

@{
    ViewData["Title"] = "Resumen de Indicadores";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="mb-3">
        <p class="text-muted">
            Vista de resumen con información agregada y estadísticas de los indicadores de Digitalización y Sostenibilidad.
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h2 class="display-4">@Model.TotalIndicadores</h2>
                    <p class="mb-0">Total de Indicadores Registrados</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-clipboard-data"></i> Indicadores por Tipo</h5>
                </div>
                <div class="card-body">
                    @if (Model.TotalPorTipo.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TotalPorTipo.OrderByDescending(x => x.Value))
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary">@item.Key</span>
                                        </td>
                                        <td class="text-end">
                                            <strong>@item.Value</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-active">
                                    <th>Total</th>
                                    <th class="text-end">@Model.TotalPorTipo.Sum(x => x.Value)</th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No hay datos disponibles</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-globe"></i> Indicadores por Ámbito</h5>
                </div>
                <div class="card-body">
                    @if (Model.TotalPorAmbito.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Ámbito</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TotalPorAmbito.OrderByDescending(x => x.Value))
                                {
                                    <tr>
                                        <td>
                                            <span class="badge bg-secondary">@item.Key</span>
                                        </td>
                                        <td class="text-end">
                                            <strong>@item.Value</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-active">
                                    <th>Total</th>
                                    <th class="text-end">@Model.TotalPorAmbito.Sum(x => x.Value)</th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No hay datos disponibles</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-tags"></i> Indicadores por Categoría</h5>
                </div>
                <div class="card-body">
                    @if (Model.TotalPorCategoria.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Categoría</th>
                                    <th class="text-end">Cantidad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.TotalPorCategoria.OrderByDescending(x => x.Value))
                                {
                                    <tr>
                                        <td>@item.Key</td>
                                        <td class="text-end">
                                            <strong>@item.Value</strong>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-active">
                                    <th>Total</th>
                                    <th class="text-end">@Model.TotalPorCategoria.Sum(x => x.Value)</th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No hay datos disponibles</p>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.IndicadoresRecientes != null)
    {
        <div class="card">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-clock-history"></i> Indicadores Más Recientes</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Nombre</th>
                                <th>Valor</th>
                                <th>Ámbito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.IndicadoresRecientes)
                            {
                                <tr>
                                    <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge bg-primary">@item.Tipo</span></td>
                                    <td>@item.Nombre</td>
                                    <td><strong>@item.Valor @item.Unidad</strong></td>
                                    <td><span class="badge bg-secondary">@item.Ambito</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
        <a asp-action="Filtros" class="btn btn-primary">
            <i class="bi bi-funnel"></i> Aplicar Filtros
        </a>
    </div>
</div>
