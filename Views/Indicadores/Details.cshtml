@model AE_RA8_RBM.DTOs.IndicadorDto

@{
    ViewData["Title"] = "Detalles del Indicador";
}

<div class="container mt-4">
    <h1>@ViewData["Title"]</h1>

    <div class="mb-3">
        <p class="text-muted">
            Información detallada del indicador obtenida desde la API REST.
        </p>
    </div>

    <div class="card">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-info-circle"></i> Indicador #@Model.Id</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">@Model.Tipo</span>
                    @if (Model.Tipo == "Digitalización")
                    {
                        <br />
                        <small class="text-muted">
                            La digitalización se refiere a la transformación de procesos tradicionales mediante tecnologías digitales.
                        </small>
                    }
                    else if (Model.Tipo == "Sostenibilidad")
                    {
                        <br />
                        <small class="text-muted">
                            La sostenibilidad busca equilibrar el crecimiento económico con la protección ambiental y el bienestar social.
                        </small>
                    }
                </dd>

                <dt class="col-sm-3">Categoría</dt>
                <dd class="col-sm-9">@Model.Categoria</dd>

                <dt class="col-sm-3">Nombre</dt>
                <dd class="col-sm-9"><strong>@Model.Nombre</strong></dd>

                <dt class="col-sm-3">Descripción</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrEmpty(Model.Descripcion))
                    {
                        @Model.Descripcion
                    }
                    else
                    {
                        <em class="text-muted">Sin descripción</em>
                    }
                </dd>

                <dt class="col-sm-3">Valor</dt>
                <dd class="col-sm-9">
                    <h4 class="text-primary">@Model.Valor @Model.Unidad</h4>
                </dd>

                <dt class="col-sm-3">Fecha</dt>
                <dd class="col-sm-9">@Model.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy")</dd>

                <dt class="col-sm-3">Ámbito</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">@Model.Ambito</span>
                </dd>
            </dl>

            <hr />

            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Editar
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Eliminar
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
            </div>
        </div>
    </div>
</div>
