@using Taller_AE4.Models.Entity
@model IEnumerable<Taller_AE4.Models.Entity.Mantenimientos>
@{
    Layout = "_Layout";
    var mantenimientos = ViewBag.Mantenimientos as List<Mantenimientos>;
    ViewData["Title"] = "Mantenimientos";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Listado de mantenimientos</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="table-container">
        <h2>Listado de mantenimientos</h2>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Id Coche</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.id</td>
                        <td>@m.fecha</td>
                        <td>@m.descripcion</td>
                        <td>@m.precio</td>
                        <td>@m.cocheId</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
