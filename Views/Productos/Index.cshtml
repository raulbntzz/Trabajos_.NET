@model List<EjercicioSupermercado.Models.Producto>

@{
    ViewData["Title"] = "Listado de productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewData["Title"]</h2>

<table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th>Medida</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.IdProducto</td>
                <td>@p.Nombre</td>
                <td>@p.Categoria?.Nombre</td>
                <td>@p.Medida</td>
                <td>@p.Precio</td>
                <td>@p.Stock</td>
            </tr>
        }
    </tbody>
</table>
