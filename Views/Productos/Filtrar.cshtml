@model List<EjercicioSupermercado.Models.Producto>

@{
    ViewData["Title"] = "Filtrar productos por categoría";
    var categorias = ViewBag.Categorias as List<EjercicioSupermercado.Models.Categoria>;
    int? seleccionada = ViewBag.IdCategoriaSeleccionada;
}

<h2>@ViewData["Title"]</h2>

<form method="get">
    <label>Categoría:</label>
    <select name="idCategoria" onchange="this.form.submit()">
        <option value="">-- Todas --</option>
        @foreach (var c in categorias!)
        {
            <option value="@c.IdCategoria" selected="@(seleccionada == c.IdCategoria)">
                @c.Nombre
            </option>
        }
    </select>
</form>

@if (Model.Count == 0)
{
    <p>No hay productos en esta categoría.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.IdProducto</td>
                    <td>@p.Nombre</td>
                    <td>@p.Categoria?.Nombre</td>
                    <td>@p.Precio</td>
                    <td>@p.Stock</td>
                </tr>
            }
        </tbody>
    </table>
}
