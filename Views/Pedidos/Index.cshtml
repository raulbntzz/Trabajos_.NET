@model List<EjercicioSupermercado.Models.Pedido>

@{
    ViewData["Title"] = "Listado de Pedidos";
}

<h2>@ViewData["Title"]</h2>

@if (Model.Count == 0)
{
    <p>No hay pedidos registrados.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID Pedido</th>
                <th>Cliente</th>
                <th>Fecha Pedido</th>
                <th>Fecha Entrega</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.IdPedido</td>
                    <td>@p.Cliente?.Cia</td>
                    <td>@p.FechaPedido.ToShortDateString()</td>
                    <td>@p.FechaEntrega.ToShortDateString()</td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@p.IdPedido">Ver Detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
