@model Venta

@{
    ViewData["Title"] = "Nueva Venta";
}

<link rel="stylesheet" href="~/css/site.css" />

<h2>Añadir Nueva Venta</h2>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="IdVenta">ID Venta:</label>
        <input asp-for="IdVenta" type="number" required />
        <span asp-validation-for="IdVenta"></span>
    </div>

    <div>
        <label asp-for="Producto">Producto:</label>
        <input asp-for="Producto" type="text" required />
        <span asp-validation-for="Producto"></span>
    </div>

    <div>
        <label asp-for="Cantidad">Cantidad:</label>
        <input asp-for="Cantidad" type="number" min="1" required />
        <span asp-validation-for="Cantidad"></span>
    </div>

    <div>
        <label asp-for="Precio">Precio:</label>
        <input asp-for="Precio" type="number" step="0.01" min="0" required />
        <span asp-validation-for="Precio"></span>
    </div>

    <div>
        <button type="submit">Guardar Venta</button>
        <a asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}