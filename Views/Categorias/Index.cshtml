@model List<EjercicioSupermercado.Models.Categoria>

@{
    ViewData["Title"] = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Categorías</h2>

@if (Model.Count == 0)
{
    <p>No hay categorías registradas.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Categoría</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.IdCategoria</td>
                    <td>@c.Nombre</td>
                </tr>
            }
        </tbody>
    </table>
}
