@using Taller_AE4.Models.Entity
@model IEnumerable<Taller_AE4.Models.Entity.Marcas>
@{
    Layout = "_Layout";
    var marcas = ViewBag.Marcas as List<Marcas>;
    ViewData["Title"] = "Marcas";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Listado de marcas</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="table-container">
        <h2>Listado de marcas</h2>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>País De Origen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.id</td>
                        <td>@m.nombre</td>
                        <td>@m.paisOrigen</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
