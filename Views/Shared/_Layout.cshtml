<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TallerCoches</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Propietarios" asp-action="Index">TallerCoches</a>

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Propietarios" asp-action="Index">Propietarios</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Coches" asp-action="Index">Coches</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Marcas" asp-action="Index">Marcas</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white" asp-controller="Mantenimientos" asp-action="Index">Mantenimientos</a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>
</body>
</html>
