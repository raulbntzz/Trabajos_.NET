@using Taller_AE4.Models.Entity
@model IEnumerable<Taller_AE4.Models.Entity.Propietarios>
@{
    Layout = "_Layout";
    var propietarios = ViewBag.Propietarios as List<Propietarios>;
    ViewData["Title"] = "Propietarios";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Listado de propietarios</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="table-container">
        <h2>Listado de clientes</h2>

        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Teléfono</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.id</td>
                        <td>@p.nombre</td>
                        <td>@p.email</td>
                        <td>@p.telefono</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
