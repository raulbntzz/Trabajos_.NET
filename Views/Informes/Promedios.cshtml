@model List<TorneoEsports.Models.DTOs.EstadisticasJugadorDTO>

<h2>Promedios por jugador</h2>

<table>
    <thead>
        <tr>
            <th>Jugador</th>
            <th>Asesinatos</th>
            <th>Muertes</th>
            <th>Asistencias</th>
            <th>Daño causado</th>
            <th>Puntuación</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.Nickname</td>
                <td>@e.PromedioAsesinatos.ToString("0.00")</td>
                <td>@e.PromedioMuertes.ToString("0.00")</td>
                <td>@e.PromedioAsistencias.ToString("0.00")</td>
                <td>@e.PromedioDanoCausado.ToString("0.00")</td>
                <td>@e.PromedioPuntuacion.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>
